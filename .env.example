API_TOKEN=change-me-to-random-string
PORT=3000
# Session duration in days (default: 30)
SESSION_TTL_DAYS=30
# Public URL shown in the web dashboard (optional)
PUBLIC_URL=http://localhost:3000
# Max cloud save upload size in MB (default: 50)
MAX_SAVE_SIZE_MB=50
# Username of the initial admin user (optional, set once on first run)
# INITIAL_ADMIN_USERNAME=admin
