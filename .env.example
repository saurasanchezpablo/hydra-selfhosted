API_TOKEN=change-me-to-random-string
PORT=3000
# Session duration in days (default: 30)
SESSION_TTL_DAYS=30
# Public URL shown in the web dashboard (optional)
PUBLIC_URL=http://localhost:3000
# Max cloud save upload size in MB (default: 50)
MAX_SAVE_SIZE_MB=50
# Max achievement souvenir screenshot size in MB (default: 10)
MAX_SOUVENIR_SIZE_MB=10
# Username of the initial admin user (optional, set once on first run)
# INITIAL_ADMIN_USERNAME=admin
# WebAuthn configuration (required for passkeys in production)
# RP_ID is the domain (e.g. your-domain.com, NOT https://your-domain.com)
# WEBAUTHN_RP_ID=your-domain.com
# ORIGIN is the full origin URL (scheme + host + port)
# WEBAUTHN_ORIGIN=https://your-domain.com
# Comma-separated list of allowed CORS origins (required for production)
# CORS_ORIGINS=https://your-domain.com,http://localhost:3000
